# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
# libheif-dev is not installed: libvips is built against the libheif
# compiled below.
RUN apk add --no-cache \
      aom-dev \
      build-base \
      cfitsio-dev \
      cgif-dev \
      cmake \
      dav1d-dev \
      expat-dev \
      fftw-dev \
      fontconfig-dev \
      glib-dev \
      highway-dev \
      lcms2-dev \
      libarchive-dev \
      libexif-dev \
      libimagequant-dev \
      libjpeg-turbo-dev \
      libjxl-dev \
      libpng-dev \
      libraw-dev \
      librsvg-dev \
      libwebp-dev \
      meson \
      openexr-dev \
      openjpeg-dev \
      pango-dev \
      pkgconf \
      scanelf \
      tiff-dev \
      x265-dev \
      xz \
      zlib-dev
ARG JOBS

# Alpine's libde265 lacks upstream security fixes, and libvips marks its HEIF
# loader as untrusted when it is built against a libheif older than 1.23.2.
# Both libraries are compiled from their upstream releases and installed
# twice: into /usr/local for the libvips build and into /out for the image.
# The options are those of the imagemagick image, plus the x265 encoder for
# HEIC saving, as in the libheif image.
ARG LIBDE265_VERSION
ARG LIBDE265_SHA256
ADD --checksum=sha256:${LIBDE265_SHA256} https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz /src/libde265.tar.gz
WORKDIR /src/libde265
RUN set -eu; \
    tar -xzf /src/libde265.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_DECODER=OFF \
      -DENABLE_SDL=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip

ARG LIBHEIF_VERSION
ARG LIBHEIF_SHA256
ADD --checksum=sha256:${LIBHEIF_SHA256} https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz /src/libheif.tar.gz
WORKDIR /src/libheif
# The codecs are compiled into libheif instead of being loaded as plugins, so
# the runtime-deps scan below finds x265, aom and dav1d. musl searches
# /usr/local/lib before /usr/lib, so no RUNPATH is needed to prefer these
# libraries over the Alpine packages.
RUN set -eu; \
    tar -xzf /src/libheif.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_PLUGIN_LOADING=OFF \
      -DWITH_LIBDE265=ON \
      -DWITH_DAV1D=ON \
      -DWITH_AOM_ENCODER=ON \
      -DWITH_AOM_DECODER=OFF \
      -DWITH_OpenH264_DECODER=OFF \
      -DWITH_X264=OFF \
      -DWITH_X265=ON \
      -DWITH_EXAMPLES=OFF \
      -DWITH_GDK_PIXBUF=OFF \
      -DBUILD_DOCUMENTATION=OFF \
      -DBUILD_TESTING=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip; \
    scanelf --needed --nobanner --format '%n#p' /usr/local/lib/libheif.so.1 | tr ',' '\n' > /tmp/libheif-needed; \
    for lib in libde265.so.0 libx265.so libaom.so libdav1d.so libsharpyuv.so; do \
      grep -Fq "$lib" /tmp/libheif-needed || { cat /tmp/libheif-needed >&2; echo "libheif does not link $lib" >&2; exit 1; }; \
    done

ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://github.com/libvips/libvips/releases/download/v${VERSION}/vips-${VERSION}.tar.xz /src/
WORKDIR /src/vips
# Every optional library is named: an enabled one makes meson setup fail when
# it is missing, and a disabled one cannot be picked up from whatever else is
# installed. libvips ignores spng when it finds libpng, and builds the GIF
# saver only with a quantiser, here libimagequant. libheif has no RUNPATH
# here, so -rpath-link tells the linker where to find the libde265 it needs
# when meson links test programs and the tools against libheif; at run time
# musl searches /usr/local/lib anyway. The translations are removed because
# the Ubuntu build does not make them (glib-dev pulls in gettext here, but
# not on Ubuntu).
RUN set -- \
      --prefix=/usr/local \
      --libdir=lib \
      --buildtype=release \
      -Db_ndebug=true \
      -Dcplusplus=false \
      -Dexamples=false \
      -Dintrospection=disabled \
      -Dmodules=disabled \
      -Dmagick=disabled \
      -Dopenslide=disabled \
      -Duhdr=disabled \
      -Dmatio=disabled \
      -Dnifti=disabled \
      -Dpdfium=disabled \
      -Dpoppler=disabled \
      -Dorc=disabled \
      -Dquantizr=disabled \
      -Dspng=disabled \
      -Dpng=enabled \
      -Dheif=enabled \
      -Djpeg-xl=enabled \
      -Dwebp=enabled \
      -Dtiff=enabled \
      -Djpeg=enabled \
      -Dcgif=enabled \
      -Dimagequant=enabled \
      -Drsvg=enabled \
      -Dpangocairo=enabled \
      -Dfontconfig=enabled \
      -Dlcms=enabled \
      -Dexif=enabled \
      -Darchive=enabled \
      -Dopenexr=enabled \
      -Dopenjpeg=enabled \
      -Dfftw=enabled \
      -Dcfitsio=enabled \
      -Draw=enabled \
      -Dhighway=enabled \
      -Dzlib=enabled; \
    echo "$*" > /tmp/meson-options; \
    tar -xJf "/src/vips-${VERSION}.tar.xz" --strip-components=1; \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig LDFLAGS=-Wl,-rpath-link,/usr/local/lib meson setup build "$@"; \
    meson compile -C build -j"${JOBS:-$(nproc)}"; \
    meson install -C build --strip --destdir /out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/cmake /out/usr/local/lib/libheif /out/usr/local/lib/pkgconfig \
      /out/usr/local/share/doc /out/usr/local/share/locale /out/usr/local/share/man

# The meson options above leave nothing to chance, but the libraries libvips
# links and the formats it registers are checked here too.
RUN scanelf --needed --nobanner --format '%n#p' /out/usr/local/lib/libvips.so.42 | tr ',' '\n' > /tmp/libvips-needed; \
    grep -Fq libheif.so.1 /tmp/libvips-needed \
      || { cat /tmp/libvips-needed >&2; echo "libvips.so.42 does not link libheif.so.1" >&2; exit 1; }; \
    bins="$(find /out/usr/local/bin -mindepth 1 -exec basename {} \; | LC_ALL=C sort | tr '\n' ' ')"; \
    test "$bins" = 'vips vipsedit vipsheader vipsthumbnail ' || { echo "unexpected programs: $bins" >&2; exit 1; }; \
    export LD_LIBRARY_PATH=/out/usr/local/lib; \
    /out/usr/local/bin/vips --version > /tmp/vips-version; \
    test "$(cat /tmp/vips-version)" = "vips-${VERSION}" || { cat /tmp/vips-version >&2; exit 1; }; \
    /out/usr/local/bin/vips -l foreign > /tmp/foreign; \
    missing=; \
    for op in jpegload jpegsave pngload pngsave gifload gifsave webpload webpsave tiffload tiffsave \
              heifload heifsave jxlload jxlsave jp2kload jp2ksave svgload openexrload fitsload fitssave \
              dcrawload dzsave; do \
      grep -Fq "($op)" /tmp/foreign || missing="$missing $op"; \
    done; \
    if [ -n "$missing" ]; then cat /tmp/foreign >&2; echo "missing:$missing" >&2; exit 1; fi; \
    if grep -F '(heifload)' /tmp/foreign | grep -Fq untrusted; then \
      grep -F '(heifload)' /tmp/foreign >&2; echo "heifload is marked untrusted" >&2; exit 1; \
    fi

ARG BASE_IMAGE
# runtime-deps lists the so: names the tools and libvips need, minus the
# libraries built here, plus the packages in runtime-deps.alpine. Radiance's
# license is cut from the first comment of the files that contain its code.
RUN --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    export LC_ALL=C; \
    meta=/out/usr/local/share/randomcontainers/libvips; \
    mkdir -p "$meta/licenses"; \
    cp LICENSE "$meta/licenses/LICENSE"; \
    cp libvips/foreign/libnsgif/COPYING "$meta/licenses/COPYING.libnsgif"; \
    for f in libvips/foreign/radiance.c libvips/colour/float2rad.c libvips/colour/rad2float.c; do \
      awk '/^\/\* =+$/ { p = 1 } p { print } p && /^ \*\/$/ { exit }' "$f" \
        | sed -e 's/^\/\* //' -e 's/^ \*\/$//' -e 's/^ \* \{0,1\}//' -e '/^==*$/d' > "/tmp/${f##*/}.notice"; \
      grep -Fq 'Radiance Software License' "/tmp/${f##*/}.notice" \
        || { echo "no Radiance license notice in $f" >&2; exit 1; }; \
    done; \
    { \
      printf '%s\n\n' 'libvips/foreign/radiance.c:'; \
      cat /tmp/radiance.c.notice; \
      if cmp -s /tmp/float2rad.c.notice /tmp/rad2float.c.notice; then \
        printf '%s\n\n' 'libvips/colour/float2rad.c and libvips/colour/rad2float.c:'; \
        cat /tmp/float2rad.c.notice; \
      else \
        printf '%s\n\n' 'libvips/colour/float2rad.c:'; \
        cat /tmp/float2rad.c.notice; \
        printf '%s\n\n' 'libvips/colour/rad2float.c:'; \
        cat /tmp/rad2float.c.notice; \
      fi; \
    } > "$meta/licenses/COPYING.radiance"; \
    cp /src/libde265/COPYING "$meta/licenses/COPYING.libde265"; \
    cp /src/libheif/COPYING "$meta/licenses/COPYING.libheif"; \
    for f in "$meta"/licenses/*; do test -s "$f"; done; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://github.com/libvips/libvips/releases/download/v${VERSION}/vips-${VERSION}.tar.xz" \
      "https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz" \
      "https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz" \
      "https://github.com/randomcontainers/libvips/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | sed -n 1p)"; \
      echo "libvips: ${VERSION} sha256:${SOURCE_SHA256}"; \
      echo "libde265: ${LIBDE265_VERSION} sha256:${LIBDE265_SHA256}"; \
      echo "libheif: ${LIBHEIF_VERSION} sha256:${LIBHEIF_SHA256}"; \
      echo "meson: $(cat /tmp/meson-options)"; \
      LD_LIBRARY_PATH=/out/usr/local/lib /out/usr/local/bin/vips --vips-config; \
    } > "$meta/buildinfo"; \
    scanelf --needed --nobanner --format '%n#p' --recursive /out/usr/local | tr ',' '\n' | sort -u > /tmp/needed; \
    while read -r so; do \
      if [ -n "$so" ] && [ -z "$(find /out -name "$so" -print -quit)" ]; then echo "so:$so"; fi; \
    done < /tmp/needed > /tmp/elf-deps; \
    test -s /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"; \
    if grep -E '^(so:)?lib(heif|de265)' "$meta/runtime-deps"; then \
      echo "runtime-deps must not pull in the distro's libheif or libde265" >&2; exit 1; \
    fi

FROM ${BASE_IMAGE} AS slim
COPY --link --from=build /out/usr/local/ /usr/local/
RUN set -eu; \
    xargs apk add --no-cache ca-certificates tini < /usr/local/share/randomcontainers/libvips/runtime-deps; \
    fc-cache -f; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "vips"]
CMD ["--help"]
