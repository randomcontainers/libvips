# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
# The base image's own packages are recorded first so they can be left out of
# runtime-deps. aom-tools, libwebm-dev and libyuv-dev are only there for
# libheif's CMake build: the CMake package in libaom-dev declares aomdec and
# aomenc from aom-tools, which must exist, and lists libwebm and libyuv as
# link dependencies. libheif-dev is not installed: libvips is built against
# the libheif compiled below.
RUN dpkg-query -W -f '${Package}\n' | LC_ALL=C sort -u > /tmp/base-packages; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      aom-tools \
      build-essential \
      cmake \
      libaom-dev \
      libarchive-dev \
      libcfitsio-dev \
      libcgif-dev \
      libdav1d-dev \
      libexif-dev \
      libexpat1-dev \
      libfftw3-dev \
      libfontconfig-dev \
      libglib2.0-dev \
      libhwy-dev \
      libimagequant-dev \
      libjpeg-turbo8-dev \
      libjxl-dev \
      liblcms2-dev \
      libopenexr-dev \
      libopenjp2-7-dev \
      libpango1.0-dev \
      libpng-dev \
      libraw-dev \
      librsvg2-dev \
      libsharpyuv-dev \
      libtiff-dev \
      libwebm-dev \
      libwebp-dev \
      libx265-dev \
      libyuv-dev \
      meson \
      pkgconf \
      xz-utils \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
ARG JOBS

# Ubuntu's libde265 lacks upstream security fixes, and libvips marks its HEIF
# loader as untrusted when it is built against a libheif older than 1.23.2,
# such as Ubuntu's. Both libraries are compiled from their upstream releases
# and installed twice: into /usr/local for the libvips build and into /out for
# the image. The options are those of the imagemagick image, plus the x265
# encoder for HEIC saving, as in the libheif image.
ARG LIBDE265_VERSION
ARG LIBDE265_SHA256
ADD --checksum=sha256:${LIBDE265_SHA256} https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz /src/libde265.tar.gz
WORKDIR /src/libde265
RUN set -eu; \
    tar -xzf /src/libde265.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_DECODER=OFF \
      -DENABLE_SDL=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip

ARG LIBHEIF_VERSION
ARG LIBHEIF_SHA256
ADD --checksum=sha256:${LIBHEIF_SHA256} https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz /src/libheif.tar.gz
WORKDIR /src/libheif
# The codecs are compiled into libheif instead of being loaded as plugins, so
# the runtime-deps scan below finds x265, aom and dav1d. The RUNPATH keeps
# libheif on the libde265 built here even in an image that also has the
# Ubuntu package: on arm64 the loader searches /usr/lib/aarch64-linux-gnu
# before /usr/local/lib.
RUN set -eu; \
    tar -xzf /src/libheif.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_RPATH=/usr/local/lib \
      -DENABLE_PLUGIN_LOADING=OFF \
      -DWITH_LIBDE265=ON \
      -DWITH_DAV1D=ON \
      -DWITH_AOM_ENCODER=ON \
      -DWITH_AOM_DECODER=OFF \
      -DWITH_OpenH264_DECODER=OFF \
      -DWITH_X264=OFF \
      -DWITH_X265=ON \
      -DWITH_EXAMPLES=OFF \
      -DWITH_GDK_PIXBUF=OFF \
      -DBUILD_DOCUMENTATION=OFF \
      -DBUILD_TESTING=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip; \
    ldconfig; \
    readelf -d /usr/local/lib/libheif.so.1 > /tmp/libheif-dynamic; \
    for lib in libde265.so.0 libx265.so libaom.so libdav1d.so libsharpyuv.so; do \
      grep -Fq "Shared library: [$lib" /tmp/libheif-dynamic || { cat /tmp/libheif-dynamic >&2; echo "libheif does not link $lib" >&2; exit 1; }; \
    done; \
    grep -Eq 'Library (rpath|runpath): \[/usr/local/lib\]' /tmp/libheif-dynamic

ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://github.com/libvips/libvips/releases/download/v${VERSION}/vips-${VERSION}.tar.xz /src/
WORKDIR /src/vips
# Every optional library is named: an enabled one makes meson setup fail when
# it is missing, and a disabled one cannot be picked up from whatever else is
# installed. libvips ignores spng when it finds libpng, and builds the GIF
# saver only with a quantiser, here libimagequant. The RUNPATH makes libvips
# load the libheif built above, for the same reason as libheif's: this image
# also gets Ubuntu's libheif1, which librsvg pulls in through gdk-pixbuf.
# The translations are removed because the Alpine build makes them and this
# one does not (gettext is not installed).
RUN set -- \
      --prefix=/usr/local \
      --libdir=lib \
      --buildtype=release \
      -Db_ndebug=true \
      -Dcplusplus=false \
      -Dexamples=false \
      -Dintrospection=disabled \
      -Dmodules=disabled \
      -Dmagick=disabled \
      -Dopenslide=disabled \
      -Duhdr=disabled \
      -Dmatio=disabled \
      -Dnifti=disabled \
      -Dpdfium=disabled \
      -Dpoppler=disabled \
      -Dorc=disabled \
      -Dquantizr=disabled \
      -Dspng=disabled \
      -Dpng=enabled \
      -Dheif=enabled \
      -Djpeg-xl=enabled \
      -Dwebp=enabled \
      -Dtiff=enabled \
      -Djpeg=enabled \
      -Dcgif=enabled \
      -Dimagequant=enabled \
      -Drsvg=enabled \
      -Dpangocairo=enabled \
      -Dfontconfig=enabled \
      -Dlcms=enabled \
      -Dexif=enabled \
      -Darchive=enabled \
      -Dopenexr=enabled \
      -Dopenjpeg=enabled \
      -Dfftw=enabled \
      -Dcfitsio=enabled \
      -Draw=enabled \
      -Dhighway=enabled \
      -Dzlib=enabled; \
    echo "$*" > /tmp/meson-options; \
    tar -xJf "/src/vips-${VERSION}.tar.xz" --strip-components=1; \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig LDFLAGS=-Wl,-rpath,/usr/local/lib meson setup build "$@"; \
    meson compile -C build -j"${JOBS:-$(nproc)}"; \
    meson install -C build --strip --destdir /out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/cmake /out/usr/local/lib/libheif /out/usr/local/lib/pkgconfig \
      /out/usr/local/share/doc /out/usr/local/share/locale /out/usr/local/share/man

# The meson options above leave nothing to chance, but the libraries libvips
# links and the formats it registers are checked here too.
RUN readelf -d /out/usr/local/lib/libvips.so.42 > /tmp/libvips-dynamic; \
    grep -Eq 'Library (rpath|runpath): \[/usr/local/lib\]' /tmp/libvips-dynamic \
      || { cat /tmp/libvips-dynamic >&2; echo "libvips.so.42 has no RUNPATH /usr/local/lib" >&2; exit 1; }; \
    grep -Fq 'Shared library: [libheif.so.1]' /tmp/libvips-dynamic \
      || { cat /tmp/libvips-dynamic >&2; echo "libvips.so.42 does not link libheif.so.1" >&2; exit 1; }; \
    ldd /out/usr/local/lib/libvips.so.42 > /tmp/libvips-ldd; \
    for lib in libheif.so.1 libde265.so.0; do \
      grep -Fq "$lib => /usr/local/lib/$lib " /tmp/libvips-ldd \
        || { cat /tmp/libvips-ldd >&2; echo "$lib does not resolve to /usr/local/lib" >&2; exit 1; }; \
    done; \
    bins="$(find /out/usr/local/bin -mindepth 1 -printf '%f\n' | LC_ALL=C sort | tr '\n' ' ')"; \
    test "$bins" = 'vips vipsedit vipsheader vipsthumbnail ' || { echo "unexpected programs: $bins" >&2; exit 1; }; \
    export LD_LIBRARY_PATH=/out/usr/local/lib; \
    /out/usr/local/bin/vips --version > /tmp/vips-version; \
    test "$(cat /tmp/vips-version)" = "vips-${VERSION}" || { cat /tmp/vips-version >&2; exit 1; }; \
    /out/usr/local/bin/vips -l foreign > /tmp/foreign; \
    missing=; \
    for op in jpegload jpegsave pngload pngsave gifload gifsave webpload webpsave tiffload tiffsave \
              heifload heifsave jxlload jxlsave jp2kload jp2ksave svgload openexrload fitsload fitssave \
              dcrawload dzsave; do \
      grep -Fq "($op)" /tmp/foreign || missing="$missing $op"; \
    done; \
    if [ -n "$missing" ]; then cat /tmp/foreign >&2; echo "missing:$missing" >&2; exit 1; fi; \
    if grep -F '(heifload)' /tmp/foreign | grep -Fq untrusted; then \
      grep -F '(heifload)' /tmp/foreign >&2; echo "heifload is marked untrusted" >&2; exit 1; \
    fi

ARG BASE_IMAGE
# runtime-deps lists the packages that own the libraries the tools and
# libvips load, minus the base image's packages, plus the packages in
# runtime-deps.ubuntu. Radiance's license is cut from the first comment of
# the files that contain its code.
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps.extra \
    export LC_ALL=C; \
    meta=/out/usr/local/share/randomcontainers/libvips; \
    mkdir -p "$meta/licenses"; \
    cp LICENSE "$meta/licenses/LICENSE"; \
    cp libvips/foreign/libnsgif/COPYING "$meta/licenses/COPYING.libnsgif"; \
    for f in libvips/foreign/radiance.c libvips/colour/float2rad.c libvips/colour/rad2float.c; do \
      awk '/^\/\* =+$/ { p = 1 } p { print } p && /^ \*\/$/ { exit }' "$f" \
        | sed -e 's/^\/\* //' -e 's/^ \*\/$//' -e 's/^ \* \{0,1\}//' -e '/^==*$/d' > "/tmp/${f##*/}.notice"; \
      grep -Fq 'Radiance Software License' "/tmp/${f##*/}.notice" \
        || { echo "no Radiance license notice in $f" >&2; exit 1; }; \
    done; \
    { \
      printf '%s\n\n' 'libvips/foreign/radiance.c:'; \
      cat /tmp/radiance.c.notice; \
      if cmp -s /tmp/float2rad.c.notice /tmp/rad2float.c.notice; then \
        printf '%s\n\n' 'libvips/colour/float2rad.c and libvips/colour/rad2float.c:'; \
        cat /tmp/float2rad.c.notice; \
      else \
        printf '%s\n\n' 'libvips/colour/float2rad.c:'; \
        cat /tmp/float2rad.c.notice; \
        printf '%s\n\n' 'libvips/colour/rad2float.c:'; \
        cat /tmp/rad2float.c.notice; \
      fi; \
    } > "$meta/licenses/COPYING.radiance"; \
    cp /src/libde265/COPYING "$meta/licenses/COPYING.libde265"; \
    cp /src/libheif/COPYING "$meta/licenses/COPYING.libheif"; \
    for f in "$meta"/licenses/*; do test -s "$f"; done; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://github.com/libvips/libvips/releases/download/v${VERSION}/vips-${VERSION}.tar.xz" \
      "https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz" \
      "https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz" \
      "https://github.com/randomcontainers/libvips/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | sed -n 1p)"; \
      echo "libvips: ${VERSION} sha256:${SOURCE_SHA256}"; \
      echo "libde265: ${LIBDE265_VERSION} sha256:${LIBDE265_SHA256}"; \
      echo "libheif: ${LIBHEIF_VERSION} sha256:${LIBHEIF_SHA256}"; \
      echo "meson: $(cat /tmp/meson-options)"; \
      LD_LIBRARY_PATH=/out/usr/local/lib /out/usr/local/bin/vips --vips-config; \
    } > "$meta/buildinfo"; \
    find /out/usr/local -type f \( -perm -u+x -o -name '*.so*' \) -print0 \
      | xargs -0 env LD_LIBRARY_PATH=/out/usr/local/lib ldd > /tmp/ldd 2>&1 || true; \
    if grep 'not found' /tmp/ldd; then exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// && $3 !~ /^\/out\// { print $3 }' /tmp/ldd | sort -u > /tmp/libs; \
    test -s /tmp/libs; \
    while read -r lib; do \
      real="$(readlink -f "$lib")"; \
      dpkg-query --search "*${real#/usr}"; \
    done < /tmp/libs | cut -d: -f1 | sort -u | comm -23 - /tmp/base-packages > /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"; \
    if grep -E '^lib(heif|de265)' "$meta/runtime-deps"; then \
      echo "runtime-deps must not pull in the distro's libheif or libde265" >&2; exit 1; \
    fi

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=build /out/usr/local/ /usr/local/
# libvips and libheif find the libraries in /usr/local/lib through their
# RUNPATH, and other programs through the cache that ldconfig writes.
RUN set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /usr/local/share/randomcontainers/libvips/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig; \
    fc-cache -f; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "vips"]
CMD ["--help"]
